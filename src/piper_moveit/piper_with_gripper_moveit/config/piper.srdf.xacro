<?xml version="1.0" encoding="UTF-8"?>
<robot name="piper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="la_piper_"/>

  <group name="arm">
    <chain base_link="$(arg prefix)base_link" tip_link="$(arg prefix)link6"/>
  </group>

  <group name="gripper">
    <chain base_link="$(arg prefix)gripper_base" tip_link="$(arg prefix)link7"/>
  </group>

  <group_state name="zero" group="arm">
    <joint name="$(arg prefix)joint1" value="0"/>
    <joint name="$(arg prefix)joint2" value="0"/>
    <joint name="$(arg prefix)joint3" value="0"/>
    <joint name="$(arg prefix)joint4" value="0"/>
    <joint name="$(arg prefix)joint5" value="0"/>
    <joint name="$(arg prefix)joint6" value="0"/>
  </group_state>

  <group_state name="init" group="arm">
    <joint name="$(arg prefix)joint1" value="0"/>
    <joint name="$(arg prefix)joint2" value="0"/>
    <joint name="$(arg prefix)joint3" value="0"/>
    <joint name="$(arg prefix)joint4" value="0"/>
    <joint name="$(arg prefix)joint5" value="0"/>
    <joint name="$(arg prefix)joint6" value="0"/>
  </group_state>

  <group_state name="rest" group="arm">
    <joint name="$(arg prefix)joint1" value="0"/>
    <joint name="$(arg prefix)joint2" value="0"/>
    <joint name="$(arg prefix)joint3" value="0"/>
    <joint name="$(arg prefix)joint4" value="0"/>
    <joint name="$(arg prefix)joint5" value="0"/>
    <joint name="$(arg prefix)joint6" value="0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="$(arg prefix)joint7" value="0.035"/>
  </group_state>

  <group_state name="close" group="gripper">
    <joint name="$(arg prefix)joint7" value="0"/>
  </group_state>

  <group_state name="init" group="gripper">
    <joint name="$(arg prefix)joint7" value="0"/>
  </group_state>

  <disable_collisions link1="$(arg prefix)base_link" link2="$(arg prefix)link1" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)base_link" link2="$(arg prefix)link2" reason="Never"/>
  <disable_collisions link1="$(arg prefix)base_link" link2="$(arg prefix)link3" reason="Never"/>
  <disable_collisions link1="$(arg prefix)gripper_base" link2="$(arg prefix)link3" reason="Never"/>
  <disable_collisions link1="$(arg prefix)gripper_base" link2="$(arg prefix)link4" reason="Never"/>
  <disable_collisions link1="$(arg prefix)gripper_base" link2="$(arg prefix)link5" reason="Never"/>
  <disable_collisions link1="$(arg prefix)gripper_base" link2="$(arg prefix)link6" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)gripper_base" link2="$(arg prefix)link7" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)gripper_base" link2="$(arg prefix)link8" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)link1" link2="$(arg prefix)link2" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)link1" link2="$(arg prefix)link3" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link2" link2="$(arg prefix)link3" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)link2" link2="$(arg prefix)link4" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link3" link2="$(arg prefix)link4" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)link3" link2="$(arg prefix)link5" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link3" link2="$(arg prefix)link6" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link3" link2="$(arg prefix)link7" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link3" link2="$(arg prefix)link8" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link4" link2="$(arg prefix)link5" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)link4" link2="$(arg prefix)link6" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link4" link2="$(arg prefix)link7" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link4" link2="$(arg prefix)link8" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link5" link2="$(arg prefix)link6" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)link5" link2="$(arg prefix)link7" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link5" link2="$(arg prefix)link8" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link6" link2="$(arg prefix)link7" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link6" link2="$(arg prefix)link8" reason="Never"/>
  <disable_collisions link1="$(arg prefix)link7" link2="$(arg prefix)link8" reason="Default"/>

</robot>
